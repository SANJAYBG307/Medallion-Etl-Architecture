# Python cache / bytecode
# ------------------------------
__pycache__/
*.py[cod]
*$py.class

# ------------------------------
# Virtual environments
# ------------------------------
.venv/
venv/
env/
myenv/

# ------------------------------
# Python tooling
# ------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ------------------------------
# Build / packaging
# ------------------------------
build/
dist/
*.egg-info/
.eggs/

# ------------------------------
# Jupyter
# ------------------------------
.ipynb_checkpoints/

