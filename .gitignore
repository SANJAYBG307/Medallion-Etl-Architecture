.env
.env.*
!.env.example
INTERVIEW_STAR_STORY.md

# ------------------------------
# ETL generated artifacts
# ------------------------------
**/logs/*.log
**/logs/*_stage_metrics.jsonl
**/logs/*_data_quality_checks.jsonl
**/logs/*_run_summary.json
**/parquet/**/*.parquet

# Keep folder structure in git
!**/logs/.gitkeep
!**/parquet/.gitkeep
!**/parquet/bronze/.gitkeep
!**/parquet/silver/.gitkeep
!**/parquet/gold/.gitkeep
